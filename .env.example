# --- OpenAI ---
OPENAI_API_KEY=sk-...

# Answer composition. Must support JSON response format.
OPENAI_CHAT_MODEL=gpt-4o-mini
# Corpus structuring during ingestion; the bulk of ingest cost.
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Used at full native width on both the write and the read side. Changing
# either value means rebuilding the collection.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- AstraDB ---
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_KEYSPACE_NAME=default_keyspace
# Created on first ingest run. The old `igbo_proverbs` collection is left alone.
ASTRA_DB_COLLECTION_NAME=igbo_corpus

# --- Retrieval ---
RETRIEVAL_K=8
